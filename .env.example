# Anime Buddy environment — copy to .env.local

# Base URL of the deployed Cloudflare Worker (keeps DeepSeek/TMDB keys off the client).
# Scan/vision requires this Worker with DEEPSEEK_API_KEY set as a Worker secret.
VITE_WORKER_URL=

# AI provider: "mock" (default, offline) or "deepseek" (requires VITE_WORKER_URL).
# Chat/recommend only. Scan always uses Worker /api/ai/vision (DeepSeek V4 Flash).
VITE_AI_PROVIDER=mock

# SERVER / WORKER SECRETS — never prefix with VITE_, never commit:
#   DEEPSEEK_API_KEY
#   TMDB_API_KEY
