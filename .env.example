# Anime Buddy environment — copy to .env.local

# Base URL of the deployed Cloudflare Worker (keeps DeepSeek/TMDB keys off the client).
# Leave empty to run fully local with the Mock AI provider and no TMDB enrichment.
VITE_WORKER_URL=

# AI provider: "mock" (default, offline) or "deepseek" (requires VITE_WORKER_URL).
VITE_AI_PROVIDER=mock
