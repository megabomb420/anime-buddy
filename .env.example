# Anime Buddy environment

# Public Worker origin (not a secret). Baked into the app as a default;
# this env var overrides the default at build time. Profile can still
# override in the browser.
VITE_WORKER_URL=https://anime-buddy-worker.whip-blanket.workers.dev

# Chat/recommend provider: "mock" (offline) or "deepseek" (via Worker).
# A Worker URL automatically uses deepseek.
VITE_AI_PROVIDER=mock

# SERVER / WORKER ONLY — never prefix with VITE_. Put this in Cloudflare
# Worker secrets (Settings → Variables and Secrets), not in the repo:
#   DEEPSEEK_API_KEY=...
#   TMDB_API_KEY=...
