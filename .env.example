# Anime Buddy environment

# Optional Cloudflare Worker (keeps TMDB + DeepSeek keys off the client).
# You can also paste this URL in Profile → Scan vision (browser-only override).
VITE_WORKER_URL=

# Chat/recommend provider: "mock" (offline) or "deepseek" (via Worker).
# Connecting a Worker URL automatically uses deepseek.
VITE_AI_PROVIDER=mock

# SERVER / WORKER ONLY — never prefix with VITE_. Put this in Cloudflare
# Worker secrets (Settings → Variables and Secrets), not in the repo:
#   DEEPSEEK_API_KEY=...
#   TMDB_API_KEY=...
