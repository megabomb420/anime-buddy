# Copy to wrangler.toml for local `wrangler dev` if you need to change CORS.
# Production secrets: Cloudflare dashboard → Worker → Settings →
# Variables and Secrets → Add → Secret
#   DEEPSEEK_API_KEY
#   TMDB_API_KEY
# Never put those values in this file — empty [vars] placeholders overwrite secrets on deploy.

name = "anime-buddy-worker"
main = "src/index.ts"
compatibility_date = "2026-08-23"

[vars]
ALLOWED_ORIGINS = "*"
